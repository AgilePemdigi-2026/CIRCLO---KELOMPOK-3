# Salin menjadi .env lalu isi. Jangan di-commit ke GitHub.
GEMINI_API_KEY=isi_api_key_dari_Google_AI_Studio
# Opsional. Ganti jika model default sudah tidak tersedia.
GEMINI_MODEL=gemini-2.5-flash
# Kunci bersama antara Next.js dan service ini. Isi dengan string acak yang panjang.
AI_SERVICE_KEY=ganti_dengan_string_acak
