# Salin menjadi .env.local lalu isi. Jangan di-commit ke GitHub.

# CIRCLO AI Service (ai-service/). Lokal: http://localhost:8000, produksi: URL dari Render.
AI_SERVICE_URL=http://localhost:8000
# Harus sama dengan AI_SERVICE_KEY di ai-service/.env
AI_SERVICE_KEY=

# Supabase (Project Settings > API). Kosongkan untuk mode demo (data hanya di browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opsional, isi kalau nama tabel/bucket di database berbeda
# NEXT_PUBLIC_SUPABASE_MATERIALS_TABLE=materials
# NEXT_PUBLIC_SUPABASE_BUCKET=material-photos
# Alamat halaman login (bawaan /login)
# NEXT_PUBLIC_LOGIN_PATH=/login
