# Salin jadi .env.local lalu isi nilainya
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# low | medium | high. Untuk klasifikasi cukup low (lebih cepat dan hemat)
GEMINI_THINKING_LEVEL=low

# Supabase: URL ada di Project Settings > API (bentuknya https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opsional, isi kalau nama tabel/bucket di database berbeda
# NEXT_PUBLIC_SUPABASE_MATERIALS_TABLE=materials
# NEXT_PUBLIC_SUPABASE_BUCKET=material-photos
